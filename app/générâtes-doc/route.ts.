// app/api/generate-doc/route.ts
import { NextResponse } from 'next/server';

export async function POST(req: Request) {
  try {
    const { docId, formData } = await req.json();

    const apiKey = process.env.OPENAI_API_KEY;

    // Si aucune clé API n'est définie, utiliser le moteur de secours intelligent
    if (!apiKey) {
      const fallbackContent = generateFallbackContent(docId, formData);
      return NextResponse.json({ content: fallbackContent });
    }

    // Prompt système strict respectant les règles
    const systemPrompt = `Tu es un rédacteur professionnel et juriste d'entreprise.
Ton rôle est de transformer des données brutes en un document parfaitement rédigé et structuré.

RÈGLES ABSOLUES :
1. NE JAMAIS INVENTER de faits, diplômes, expériences, compétences ou chiffres non fournis.
2. Reformule, améliore la syntaxe et la fluidité avec un français professionnel moderne.
3. Si une donnée manque, rédige de manière élégante sans faire mention de l'absence de donnée.
4. Retourne UNIQUEMENT la rédaction du document au format texte propre ou HTML léger (ex: <p>, <ul>, <li>, <strong>). Sans markdown ni balises \`\`\`html.`;

    const userPrompt = `Type de document : ${docId}\nDonnées sources fournies :\n${JSON.stringify(formData, null, 2)}`;

    const response = await fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${apiKey}`,
      },
      body: JSON.stringify({
        model: 'gpt-4o-mini',
        messages: [
          { role: 'system', content: systemPrompt },
          { role: 'user', content: userPrompt },
        ],
        temperature: 0.7,
      }),
    });

    if (!response.ok) {
      throw new Error('Erreur API IA');
    }

    const data = await response.json();
    const generatedText = data.choices[0]?.message?.content || generateFallbackContent(docId, formData);

    return NextResponse.json({ content: generatedText });

  } catch (error) {
    console.error('Erreur de génération :', error);
    // Utiliser le fallback en cas de panne réseau ou erreur API
    const { docId, formData } = await req.json().catch(() => ({ docId: 'lettre', formData: {} }));
    return NextResponse.json({ content: generateFallbackContent(docId, formData) });
  }
}

// Moteur de secours (Fallback Rédactionnel) sans halllucination
function generateFallbackContent(docId: string, data: any): string {
  if (docId === 'lettre') {
    return `
<p>Madame, Monsieur,</p>

<p>C'est avec un vif intérêt que je vous adresse ma candidature pour le poste de <strong>${data.jobTitle || "Chargé d'affaires"}</strong> au sein de <strong>${data.recipient || 'votre entreprise'}</strong>.</p>

<p>Fort(e) de mon parcours en <em>${data.education || 'formation professionnelle'}</em>${data.experience ? ` et de mon expérience en tant que ${data.experience}` : ''}, j'ai développé des compétences solides${data.skills ? `, notamment en ${data.skills}` : ''}. Mon parcours m'a permis d'acquérir la rigueur et la réactivité indispensables à ce poste.</p>

${data.motivation ? `<p>Rejoindre votre structure représente une réelle opportunité. ${data.motivation}</p>` : `<p>Intégrer vos équipes représente pour moi l'opportunité de mettre pleinement à contribution mes compétences et mon engagement au service de vos objectifs.</p>`}

<p>Je reste à votre entière disposition pour un entretien afin de vous exposer plus en détail mes motivations.</p>

<p>Je vous prie d'agréer, Madame, Monsieur, l'expression de mes salutations distinguées.</p>
    `.trim();
  }

  return `<p>Document généré pour ${data.name || 'le client'}.</p>`;
}
